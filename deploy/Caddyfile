{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2
		# read_body maps to Go's ReadTimeout; it must stay well above the
		# relay's long_poll (25s) so parked polls are never cut, while still
		# bounding a slow-body client at this hop too.
		timeouts {
			read_header 10s
			read_body 60s
		}
	}
}

{$TPROXY_HOSTNAME} {
	# One backend serves the whole surface — the operator site, the bridge page
	# for a valid capability, and the API. Proxying every path (not just
	# `/` and `/api/v1/*`) keeps one public gateway for static or delegated
	# application responses and the transport. No file_server or separate
	# site route exposes different encoding, range, method, or proxy behavior.
	# `encode` wraps every response identically.
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Via
	reverse_proxy 127.0.0.1:8080 {
		transport http {
			response_header_timeout 40s
		}
	}

	# When the backend is down every path looks the same "backend unavailable",
	# which is indistinguishable from any other backend-down site; no path is
	# special-cased here.
	handle_errors {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self'; worker-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}
}
